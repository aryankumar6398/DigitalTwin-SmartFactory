# ====================================================================
# Smart Factory AI Digital Twin - Environment Configuration
# ====================================================================

# MQTT Broker / HiveMQ Cloud Settings
# For Local Mosquitto:
# MQTT_BROKER_HOST=localhost
# MQTT_BROKER_PORT=1883
# MQTT_TLS=false
#
# For HiveMQ Cloud:
# MQTT_BROKER_HOST=your-cluster-id.s1.eu.hivemq.cloud
# MQTT_BROKER_PORT=8883
# MQTT_USERNAME=your_hivemq_username
# MQTT_PASSWORD=your_hivemq_password
# MQTT_TLS=true
# MQTT_KEEPALIVE=60

MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_KEEPALIVE=60

# SQLite Database
DATABASE_PATH=data/smart_factory.db

# FastAPI Backend & Digital Twin Web Service
API_HOST=127.0.0.1
API_PORT=8000

# Physics Simulation Interval
SIMULATION_INTERVAL_SEC=1.0

# PyTorch Deep Learning Artifacts
AI_MODEL_PATH=ai/models/anomaly_detector.pt
